  <transform>
    <type>ScriptValueMod</type>
    <name>Aplicar regras trancamento</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
function txt(v) {
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function nrm(v) {
  return txt(v).toUpperCase();
}
function toInt(v) {
  var s = txt(v);
  if (s === "") return 0;
  var n = parseInt(s, 10);
  return isNaN(n) ? 0 : n;
}
function parseDataMulti(valor) {
  var s = txt(valor);
  if (s === "") return { ok: false, iso: "", motivo: "CAMPO_OBRIGATORIO:data_ocorrencia" };
  var list = ["yyyy-MM-dd", "dd/MM/yyyy", "dd-MM-yyyy", "yyyy/MM/dd", "dd.MM.yyyy", "yyyyMMdd"];
  var i, sdf, d, iso;
  for (i = 0; i &lt; list.length; i++) {
    try {
      sdf = new java.text.SimpleDateFormat(list[i]);
      sdf.setLenient(false);
      d = sdf.parse(s);
      iso = new java.text.SimpleDateFormat("yyyy-MM-dd").format(d);
      return { ok: true, iso: "" + iso, motivo: "" };
    } catch (e) {}
  }
  return { ok: false, iso: "", motivo: "DATA_FORMATO_INVALIDO" };
}
function periodoValido(v) {
  return txt(v).match(/^[0-9]{4}\.[12]$/) != null;
}

var motivos = [];
matricula = txt(matricula);
periodo = txt(periodo);
tipo_trancamento = nrm(tipo_trancamento);
var dt = parseDataMulti(data_ocorrencia);
var cadastroOk = txt(cadastro_ok);
var qtdTxt = txt(quantidade);

if (cadastroOk === "") {
    motivos.push("MATRICULA_SEM_CADASTRO");
}

if (matricula === "") motivos.push("CAMPO_OBRIGATORIO:matricula");
if (periodo === "") motivos.push("CAMPO_OBRIGATORIO:periodo");
if (tipo_trancamento === "") motivos.push("CAMPO_OBRIGATORIO:tipo_trancamento");
if (qtdTxt === "") motivos.push("CAMPO_OBRIGATORIO:quantidade");
if (txt(data_ocorrencia) === "") motivos.push("CAMPO_OBRIGATORIO:data_ocorrencia");

if (periodo !== "" &amp;&amp; !periodoValido(periodo)) motivos.push("INTEGRIDADE:periodo");
if (tipo_trancamento !== "" &amp;&amp; ",TRANCADO,PARCIAL,TRANCAMENTO TOTAL,TRANCAMENTO PARCIAL,".indexOf("," + tipo_trancamento + ",") &lt; 0) motivos.push("INTEGRIDADE:tipo_trancamento");
if (qtdTxt !== "" &amp;&amp; (qtdTxt.match(/^[0-9]+$/) == null || toInt(qtdTxt) &lt; 1)) motivos.push("INTEGRIDADE:quantidade");
if (txt(data_ocorrencia) !== "" &amp;&amp; !dt.ok) motivos.push(dt.motivo);

var data_ocorrencia_iso = dt.iso;
var flag_valido = motivos.length === 0 ? "Y" : "N";
var motivos_rejeicao = motivos.join("|");
var fonte = "controle_trancamentos";
        </jsScript_script>
      </jsScript>
    </jsScripts>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>Alerta 4 Reprovacoes Mais Futuro</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/14 19:40:00.000</created_date>
    <modified_date>2026/09/14 19:40:00.000</modified_date>
  </info>

  <transform>
    <type>CsvInput</type>
    <name>Ler monitoramento consolidado</name>
    <filename>${PROJECT_HOME}/Data_out/monitoramento_mais_futuro.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>matricula</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>estudante</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>nome</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>curso</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>campus</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>programa</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>inicio_bolsa_iso</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>situacao_beneficio</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>quantidade_reprovacoes</name><length>9</length><type>Integer</type><format>####0</format><trim_type>both</trim_type><precision>0</precision><currency/><decimal>,</decimal><group>.</group></field>
      <field><name>quantidade_trancamentos</name><length>9</length><type>Integer</type><format>####0</format><trim_type>both</trim_type><precision>0</precision><currency/><decimal>,</decimal><group>.</group></field>
      <field><name>quantidade_ocorrencias</name><length>9</length><type>Integer</type><format>####0</format><trim_type>both</trim_type><precision>0</precision><currency/><decimal>,</decimal><group>.</group></field>
      <field><name>situacao_elegibilidade</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>acao_recomendada</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>80</xloc><yloc>160</yloc></GUI>
    <description>Entrada gerada pelo pipeline de monitoramento.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>FilterRows</type>
    <name>Exatamente 4 reprovacoes</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>quantidade_reprovacoes</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value><name>constant</name><type>Integer</type><text>4</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask/></value>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Gerar alerta</send_true_to>
    <send_false_to>Ignorar</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>336</xloc><yloc>160</yloc></GUI>
    <description>Seleciona exclusivamente bolsistas com exatamente 4 reprovações.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Dummy</type>
    <name>Ignorar</name>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>560</xloc><yloc>272</yloc></GUI>
    <description/>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>ScriptValueMod</type>
    <name>Gerar alerta</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var alerta_reprovacao = "ATENCAO: voce possui 4 reprovacoes. Mais 1 reprovacao podera resultar na perda da bolsa.";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>alerta_reprovacao</name><rename>alerta_reprovacao</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>560</xloc><yloc>160</yloc></GUI>
    <description>Mensagem destinada à comunicação preventiva com o bolsista.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>TextFileOutput</type>
    <name>Salvar alerta 4 reprovacoes</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <encoding>UTF-8</encoding>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${PROJECT_HOME}/Data_out/alertas_4_reprovacoes.csv</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>matricula</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>estudante</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>nome</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>curso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>campus</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>programa</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>inicio_bolsa_iso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>situacao_beneficio</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>quantidade_reprovacoes</name><type>Integer</type><format>####0</format><length>9</length><precision>0</precision><currency/><decimal>,</decimal><group>.</group><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>quantidade_trancamentos</name><type>Integer</type><format>####0</format><length>9</length><precision>0</precision><currency/><decimal>,</decimal><group>.</group><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>quantidade_ocorrencias</name><type>Integer</type><format>####0</format><length>9</length><precision>0</precision><currency/><decimal>,</decimal><group>.</group><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>alerta_reprovacao</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>800</xloc><yloc>160</yloc></GUI>
    <description>CSV para comunicação preventiva dos estudantes que chegaram a 4 reprovações.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <order>
    <hop><from>Ler monitoramento consolidado</from><to>Exatamente 4 reprovacoes</to><enabled>Y</enabled></hop>
    <hop><from>Exatamente 4 reprovacoes</from><to>Gerar alerta</to><enabled>Y</enabled></hop>
    <hop><from>Exatamente 4 reprovacoes</from><to>Ignorar</to><enabled>Y</enabled></hop>
    <hop><from>Gerar alerta</from><to>Salvar alerta 4 reprovacoes</to><enabled>Y</enabled></hop>
  </order>

  <notepads>
    <notepad>
      <note>Alerta preventivo: estudante com exatamente 4 reprovações após o início da bolsa.
A saída alertas_4_reprovacoes.csv deve ser usada para comunicação ao estudante.
O pipeline principal continua responsável pela regra de elegibilidade/cancelamento.</note>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>55</fontcolorgreen>
      <fontcolorblue>95</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>250</backgroundcolorgreen>
      <backgroundcolorblue>220</backgroundcolorblue>
      <bordercolorred>180</bordercolorred>
      <bordercolorgreen>160</bordercolorgreen>
      <bordercolorblue>80</bordercolorblue>
      <xloc>80</xloc>
      <yloc>8</yloc>
      <width>560</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>

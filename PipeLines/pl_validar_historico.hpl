  <transform>
    <type>ScriptValueMod</type>
    <name>Aplicar regras historico</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) {
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function nrm(v) {
  return txt(v).toUpperCase();
}
function toInt(v) {
  var s = txt(v);
  if (s === "") return 0;
  var n = parseInt(s, 10);
  return isNaN(n) ? 0 : n;
}
function parseDataMulti(valor) {
  var s = txt(valor);
  if (s === "") return { ok: false, iso: "", motivo: "CAMPO_OBRIGATORIO:data" };
  var list = ["yyyy-MM-dd", "dd/MM/yyyy", "dd-MM-yyyy", "yyyy/MM/dd", "dd.MM.yyyy", "yyyyMMdd"];
  var i, sdf, d, iso;
  for (i = 0; i &lt; list.length; i++) {
    try {
      sdf = new java.text.SimpleDateFormat(list[i]);
      sdf.setLenient(false);
      d = sdf.parse(s);
      iso = new java.text.SimpleDateFormat("yyyy-MM-dd").format(d);
      return { ok: true, iso: "" + iso, motivo: "" };
    } catch (e) {}
  }
  return { ok: false, iso: "", motivo: "DATA_FORMATO_INVALIDO" };
}
function periodoValido(v) {
  return txt(v).match(/^[0-9]{4}\.[12]$/) != null;
}

var motivos = [];
matricula = txt(matricula);
periodo = txt(periodo);
disciplina = txt(disciplina);
situacao = nrm(situacao);
var dt = parseDataMulti(data_ocorrencia);
var notaTxt = txt(nota).replace(",", ".");
var cadastroOk = txt(cadastro_ok);

if (matricula === "") motivos.push("CAMPO_OBRIGATORIO:matricula");
if (periodo === "") motivos.push("CAMPO_OBRIGATORIO:periodo");
if (disciplina === "") motivos.push("CAMPO_OBRIGATORIO:disciplina");
if (txt(nota) === "") motivos.push("CAMPO_OBRIGATORIO:nota");
if (situacao === "") motivos.push("CAMPO_OBRIGATORIO:situacao");
if (txt(data_ocorrencia) === "") motivos.push("CAMPO_OBRIGATORIO:data_ocorrencia");

if (matricula !== "" &amp;&amp; cadastroOk === "") motivos.push("MATRICULA_SEM_CADASTRO");
if (periodo !== "" &amp;&amp; !periodoValido(periodo)) motivos.push("INTEGRIDADE:periodo");
if (situacao !== "" &amp;&amp; ",APROVADO,REPROVADO,TRANCADO,".indexOf("," + situacao + ",") &lt; 0) motivos.push("INTEGRIDADE:situacao");
if (txt(nota) !== "") {
  var n = parseFloat(notaTxt);
  if (isNaN(n) || n &lt; 0 || n > 10) motivos.push("INTEGRIDADE:nota");
}
if (txt(data_ocorrencia) !== "" &amp;&amp; !dt.ok) motivos.push(dt.motivo.replace(":data", ":data_ocorrencia"));

var data_ocorrencia_iso = dt.iso;
var flag_valido = motivos.length === 0 ? "Y" : "N";
var motivos_rejeicao = motivos.join("|");
var fonte = "historico_escolar";
</jsScript_script>
      </jsScript>
    </jsScripts>

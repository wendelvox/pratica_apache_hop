  <transform>
    <type>ScriptValueMod</type>
    <name>Marcar reprovacao apos bolsa</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function trimVal(v){
  return v == null ? "" : ("" + v).replace(/^\s+|\s+$/g, "");
}
function parseIsoDate(s){
  s = trimVal(s);
  if (s === "") return null;
  try {
    var sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
    sdf.setLenient(false);
    return sdf.parse(s);
  } catch (e) {
    return null;
  }
}
var dataOcorr = trimVal(data_ocorrencia_iso);
var dataBolsa = trimVal(inicio_bolsa_iso);
var ocorrencia_pos_bolsa = 0;
if (dataOcorr !== "" &amp;&amp; dataBolsa !== "") {
  var dOcorr = parseIsoDate(dataOcorr);
  var dBolsa = parseIsoDate(dataBolsa);
  if (dOcorr != null &amp;&amp; dBolsa != null &amp;&amp; dOcorr.after(dBolsa)) {
    ocorrencia_pos_bolsa = 1;
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>ocorrencia_pos_bolsa</name>
        <rename>ocorrencia_pos_bolsa</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>0</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>432</xloc>
      <yloc>480</yloc>
    </GUI>
    <description>Marca SOMENTE reprovações ocorridas ESTRITAMENTE APÓS o início/inscrição da bolsa (comparação por java.util.Date).</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

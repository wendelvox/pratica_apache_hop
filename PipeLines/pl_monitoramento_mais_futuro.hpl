  <transform>
    <type>ScriptValueMod</type>
    <name>Classificar elegibilidade</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v){
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function toInt(v){
  var s = txt(v);
  if (s === "") return 0;
  var n = parseInt(s, 10);
  return isNaN(n) ? 0 : n;
}

var qOcor = toInt(quantidade_ocorrencias);
var situacao_elegibilidade = "ELEGIVEL";
var acao_recomendada = "MANTER";
if (qOcor > 4) {
  situacao_elegibilidade = "ACIMA_DO_LIMITE";
  acao_recomendada = "CANCELAR_BOLSA";
} else if (qOcor === 4) {
  situacao_elegibilidade = "ELEGIVEL_NO_LIMITE";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>situacao_elegibilidade</name>
        <rename>situacao_elegibilidade</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>acao_recomendada</name>
        <rename>acao_recomendada</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>Y</distribute>

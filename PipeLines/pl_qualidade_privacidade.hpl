<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>Qualidade e privacidade do cadastro</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/12 14:00:00.000</created_date>
    <modified_date>2026/09/12 14:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Ler cadastro academico</name>
    <filename>${PROJECT_HOME}/Data_in/cadastro_academico.csv</filename>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>matricula</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>cpf_id</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>nome</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>codigo_curso</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>curso</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>campus</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>situacao_academica</name><length>-1</length><type>String</type><format/><trim_type>none</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute><copies>1</copies>
    <GUI><xloc>160</xloc><yloc>240</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Normalizar e pseudonimizar</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Privacidade e qualidade</jsScript_name>
        <jsScript_script><![CDATA[
function txt(v) {
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function digits(v) {
  return txt(v).replace(/[^0-9]/g, "");
}
function sha256(v) {
  var md = java.security.MessageDigest.getInstance("SHA-256");
  var bytes = md.digest(new java.lang.String(txt(v)).getBytes("UTF-8"));
  var hex = "";
  for (var i = 0; i < bytes.length; i++) {
    var h = (bytes[i] & 0xff).toString(16);
    if (h.length < 2) h = "0" + h;
    hex += h;
  }
  return hex;
}
matricula = txt(matricula);
cpf_id = txt(cpf_id);
nome = txt(nome);
codigo_curso = txt(codigo_curso).toUpperCase();
curso = txt(curso);
campus = txt(campus);
situacao_academica = txt(situacao_academica).toUpperCase();

cpf_normalizado = digits(cpf_id);
cpf_pseudonimizado = cpf_normalizado === "" ? "" : "CPF-" + sha256(cpf_normalizado).substring(0, 12);
matricula_pseudonimizada = matricula === "" ? "" : "MAT-" + sha256(matricula).substring(0, 10);
nome_pseudonimizado = nome === "" ? "" : "Pessoa-" + sha256(nome).substring(0, 8);

var motivos = [];
if (matricula === "") motivos.push("CAMPO_OBRIGATORIO:matricula");
if (cpf_normalizado === "") motivos.push("CAMPO_OBRIGATORIO:cpf");
if (nome === "") motivos.push("CAMPO_OBRIGATORIO:nome");
if (campus === "") motivos.push("CAMPO_OBRIGATORIO:campus");
if (situacao_academica === "") motivos.push("CAMPO_OBRIGATORIO:situacao_academica");
if (matricula !== "" && matricula.match(/^[0-9]{8}$/) == null) motivos.push("INTEGRIDADE:matricula");
if (cpf_normalizado !== "" && cpf_normalizado.match(/^[0-9]{11}$/) == null) motivos.push("INTEGRIDADE:cpf");
if (situacao_academica !== "" && ",ATIVO,TRANCADO,FORMADO,JUBILADO,CANCELADO,".indexOf("," + situacao_academica + ",") < 0) motivos.push("INTEGRIDADE:situacao_academica");

var flag_valido = motivos.length === 0 ? "Y" : "N";
var motivos_rejeicao = motivos.join("|");
        ]]></jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>matricula_pseudonimizada</name><rename>matricula_pseudonimizada</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>cpf_pseudonimizado</name><rename>cpf_pseudonimizado</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>nome_pseudonimizado</name><rename>nome_pseudonimizado</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>codigo_curso</name><rename>codigo_curso</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>curso</name><rename>curso</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>campus</name><rename>campus</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>situacao_academica</name><rename>situacao_academica</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>flag_valido</name><rename>flag_valido</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>motivos_rejeicao</name><rename>motivos_rejeicao</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel><distribute>Y</distribute><copies>1</copies>
    <GUI><xloc>480</xloc><yloc>240</yloc></GUI>
    <description>Normaliza identificadores, gera pseudonimos determinísticos e elimina os valores pessoais originais das saídas.</description>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <transform>
    <type>FilterRows</type><name>Registro valido?</name>
    <compare><condition><negated>N</negated><operator>-</operator><leftvalue>flag_valido</leftvalue><function>=</function><value><name>constant</name><type>String</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value><conditions/></condition></compare>
    <send_true_to>Gravar dados minimizados</send_true_to><send_false_to>Gravar rejeitados minimizados</send_false_to>
    <distribute>Y</distribute><copies>1</copies><GUI><xloc>800</xloc><yloc>240</yloc></GUI>
    <description>Classifica os registros em validos e invalidos.</description><partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type><name>Gravar dados minimizados</name><compression>None</compression><create_parent_folder>Y</create_parent_folder><separator>;</separator><enclosure>"</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>Y</enclosure_fix_disabled><header>Y</header><footer>N</footer><format>DOS</format><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><fileNameField/><schema_definition/><ignore_fields>N</ignore_fields>
    <file><name>${PROJECT_HOME}/Data_out/cadastro_validos_minimizado.csv</name><do_not_open_new_file_init>Y</do_not_open_new_file_init><extension/><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>Y</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery/></file>
    <fields>
      <field><name>matricula_pseudonimizada</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>cpf_pseudonimizado</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>nome_pseudonimizado</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>codigo_curso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>curso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>campus</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>situacao_academica</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>flag_valido</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>motivos_rejeicao</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
    </fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>1050</xloc><yloc>160</yloc></GUI><attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type><name>Gravar rejeitados minimizados</name><compression>None</compression><create_parent_folder>Y</create_parent_folder><separator>;</separator><enclosure>"</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>Y</enclosure_fix_disabled><header>Y</header><footer>N</footer><format>DOS</format><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><fileNameField/><schema_definition/><ignore_fields>N</ignore_fields>
    <file><name>${PROJECT_HOME}/Data_out/cadastro_invalidos_minimizado.csv</name><do_not_open_new_file_init>Y</do_not_open_new_file_init><extension/><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>Y</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery/></file>
    <fields>
      <field><name>matricula_pseudonimizada</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>cpf_pseudonimizado</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>nome_pseudonimizado</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>codigo_curso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>curso</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>campus</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>situacao_academica</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>flag_valido</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
      <field><name>motivos_rejeicao</name><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><roundingType>half_even</roundingType></field>
    </fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>1050</xloc><yloc>360</yloc></GUI><attributes/>
  </transform>
  <order>
    <hop><from>Ler cadastro academico</from><to>Normalizar e pseudonimizar</to><enabled>Y</enabled></hop>
    <hop><from>Normalizar e pseudonimizar</from><to>Registro valido?</to><enabled>Y</enabled></hop>
    <hop><from>Registro valido?</from><to>Gravar dados minimizados</to><enabled>Y</enabled></hop>
    <hop><from>Registro valido?</from><to>Gravar rejeitados minimizados</to><enabled>Y</enabled></hop>
  </order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>

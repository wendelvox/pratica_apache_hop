  <transform>
    <type>ScriptValueMod</type>
    <name>Aplicar regras cadastro</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) {
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function nrm(v) {
  return txt(v).toUpperCase();
}
function toInt(v) {
  var s = txt(v);
  if (s === "") return 0;
  var n = parseInt(s, 10);
  return isNaN(n) ? 0 : n;
}
function parseDataMulti(valor) {
  var s = txt(valor);
  if (s === "") return { ok: false, iso: "", motivo: "CAMPO_OBRIGATORIO:data" };
  var list = ["yyyy-MM-dd", "dd/MM/yyyy", "dd-MM-yyyy", "yyyy/MM/dd", "dd.MM.yyyy", "yyyyMMdd"];
  var i, sdf, d, iso;
  for (i = 0; i &lt; list.length; i++) {
    try {
      sdf = new java.text.SimpleDateFormat(list[i]);
      sdf.setLenient(false);
      d = sdf.parse(s);
      iso = new java.text.SimpleDateFormat("yyyy-MM-dd").format(d);
      return { ok: true, iso: "" + iso, motivo: "" };
    } catch (e) {}
  }
  return { ok: false, iso: "", motivo: "DATA_FORMATO_INVALIDO" };
}
function periodoValido(v) {
  return txt(v).match(/^[0-9]{4}\.[12]$/) != null;
}

var motivos = [];
matricula = txt(matricula);
cpf_id = txt(cpf_id).replace(/[.\-]/g, "");
nome = txt(nome);
codigo_curso = nrm(codigo_curso);
curso = txt(curso);
campus = txt(campus);
situacao_academica = nrm(situacao_academica);
var cursoOficial = txt(curso_oficial);


if (matricula === "") motivos.push("CAMPO_OBRIGATORIO:matricula");
if (cpf_id === "") motivos.push("CAMPO_OBRIGATORIO:cpf_id");
if (nome === "") motivos.push("CAMPO_OBRIGATORIO:nome");
if (campus === "") motivos.push("CAMPO_OBRIGATORIO:campus");
if (situacao_academica === "") motivos.push("CAMPO_OBRIGATORIO:situacao_academica");
if (codigo_curso === "" &amp;&amp; curso === "") motivos.push("MATRICULA_SEM_CURSO");

if (matricula !== "" &amp;&amp; matricula.match(/^[0-9]{8}$/) == null) motivos.push("INTEGRIDADE:matricula");
if (cpf_id !== "" &amp;&amp; cpf_id.match(/^[0-9]{11}$/) == null) motivos.push("INTEGRIDADE:cpf_id");
if (situacao_academica !== "" &amp;&amp; ",ATIVO,TRANCADO,FORMADO,JUBILADO,CANCELADO,".indexOf("," + situacao_academica + ",") &lt; 0) {
  motivos.push("INTEGRIDADE:situacao_academica");
}

if (toInt(qtd_matricula) > 1) motivos.push("ESTUDANTE_DUPLICADO:matricula");
if (cpf_id !== "" &amp;&amp; toInt(qtd_cpf) > 1) motivos.push("ESTUDANTE_DUPLICADO:cpf_id");

if ((codigo_curso !== "" || curso !== "") &amp;&amp; cursoOficial === "") motivos.push("CURSO_NAO_ENCONTRADO");
if (codigo_curso !== "" &amp;&amp; cursoOficial === "") motivos.push("CODIGO_CURSO_INEXISTENTE");
if (codigo_curso !== "" &amp;&amp; cursoOficial !== "" &amp;&amp; curso !== "" &amp;&amp; nrm(curso) !== nrm(cursoOficial)) {
  motivos.push("CODIGO_CURSO_INCONSISTENTE");
}

var flag_valido = motivos.length === 0 ? "Y" : "N";
var motivos_rejeicao = motivos.join("|");
var fonte = "cadastro_academico";
</jsScript_script>
      </jsScript>
    </jsScripts>

  <transform>
    <type>ScriptValueMod</type>
    <name>Aplicar regras bolsa</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) {
  if (v == null) return "";
  return ("" + v).replace(/^\s+|\s+$/g, "");
}
function nrm(v) {
  return txt(v).toUpperCase();
}
function toInt(v) {
  var s = txt(v);
  if (s === "") return 0;
  var n = parseInt(s, 10);
  return isNaN(n) ? 0 : n;
}
function parseDataMulti(valor) {
  var s = txt(valor);
  if (s === "") return { ok: false, iso: "", motivo: "CAMPO_OBRIGATORIO:data" };
  var list = ["yyyy-MM-dd", "dd/MM/yyyy", "dd-MM-yyyy", "yyyy/MM/dd", "dd.MM.yyyy", "yyyyMMdd"];
  var i, sdf, d, iso;
  for (i = 0; i &lt; list.length; i++) {
    try {
      sdf = new java.text.SimpleDateFormat(list[i]);
      sdf.setLenient(false);
      d = sdf.parse(s);
      iso = new java.text.SimpleDateFormat("yyyy-MM-dd").format(d);
      return { ok: true, iso: "" + iso, motivo: "" };
    } catch (e) {}
  }
  return { ok: false, iso: "", motivo: "DATA_FORMATO_INVALIDO" };
}
function periodoValido(v) {
  return txt(v).match(/^[0-9]{4}\.[12]$/) != null;
}

var motivos = [];
matricula = txt(matricula);
estudante = txt(estudante);
programa = txt(programa);
situacao_beneficio = nrm(situacao_beneficio);
var dt = parseDataMulti(inicio_bolsa);
var cadastroOk = txt(cadastro_ok);

if (matricula === "") motivos.push("CAMPO_OBRIGATORIO:matricula");
if (estudante === "") motivos.push("CAMPO_OBRIGATORIO:estudante");
if (programa === "") motivos.push("CAMPO_OBRIGATORIO:programa");
if (txt(inicio_bolsa) === "") motivos.push("CAMPO_OBRIGATORIO:inicio_bolsa");
if (situacao_beneficio === "") motivos.push("CAMPO_OBRIGATORIO:situacao_beneficio");

if (matricula !== "" &amp;&amp; cadastroOk === "") motivos.push("MATRICULA_SEM_CADASTRO");
if (situacao_beneficio !== "" &amp;&amp; ",ATIVO,SUSPENSO,ENCERRADO,".indexOf("," + situacao_beneficio + ",") &lt; 0) {
  motivos.push("INTEGRIDADE:situacao_beneficio");
}
if (txt(inicio_bolsa) !== "" &amp;&amp; !dt.ok) motivos.push(dt.motivo.replace(":data", ":inicio_bolsa"));

var inicio_bolsa_iso = dt.iso;
var flag_valido = motivos.length === 0 ? "Y" : "N";
var motivos_rejeicao = motivos.join("|");
var fonte = "cadastro_bolsistas";
</jsScript_script>
      </jsScript>
    </jsScripts>

  <transform>
    <type>FilterRows</type>
    <name>Filter Rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>situacao</leftvalue>
        <function>=</function>
        <rightvalue>target_status</rightvalue>
        <conditions/>
      </condition>

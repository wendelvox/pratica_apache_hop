<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>Classificar ocorrencias Mais Futuro</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/29 18:00:00.000</created_date>
    <modified_date>2026/08/29 18:45:00.000</modified_date>
  </info>
  <transform>
    <type>CsvInput</type>
    <name>Ler ocorrencias consolidadas</name>
    <filename>${PROJECT_HOME}/Data_out/ocorrencias_consolidadas.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>matricula</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>quantidade_reprovacoes</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>quantidade_trancamentos</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>quantidade_ocorrencias</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>192</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Ultrapassou 4 ocorrencias?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>quantidade_ocorrencias</leftvalue>
        <function>&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>4</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0</mask>
        </value>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Possivel cancelamento</send_true_to>
    <send_false_to>Dentro do limite</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>192</yloc>
    </GUI>
    <description>Regra: somente quantidade superior a 4 indica possivel cancelamento.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Possivel cancelamento</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <encoding>UTF-8</encoding>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${PROJECT_HOME}/Data_out/estudantes_possivel_cancelamento.csv</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>matricula</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_reprovacoes</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_trancamentos</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_ocorrencias</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Estudantes com mais de 4 ocorrencias.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Dentro do limite</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <encoding>UTF-8</encoding>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${PROJECT_HOME}/Data_out/estudantes_dentro_limite.csv</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>matricula</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_reprovacoes</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_trancamentos</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>quantidade_ocorrencias</name>
        <type>Integer</type>
        <format>####0</format>
        <length>9</length>
        <precision>0</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>288</yloc>
    </GUI>
    <description>Estudantes com ate 4 ocorrencias, incluindo exatamente 4.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler ocorrencias consolidadas</from>
      <to>Ultrapassou 4 ocorrencias?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ultrapassou 4 ocorrencias?</from>
      <to>Possivel cancelamento</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ultrapassou 4 ocorrencias?</from>
      <to>Dentro do limite</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Lê a saida ja validada e aplica a regra > 4.</note>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>55</fontcolorgreen>
      <fontcolorblue>95</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>250</backgroundcolorgreen>
      <backgroundcolorblue>220</backgroundcolorblue>
      <bordercolorred>180</bordercolorred>
      <bordercolorgreen>160</bordercolorgreen>
      <bordercolorblue>80</bordercolorblue>
      <xloc>96</xloc>
      <yloc>48</yloc>
      <width>280</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
